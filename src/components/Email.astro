---
// Email, protected from scrapers. The address never appears in the HTML: both parts are stored
// reversed in data attributes and assembled on click. Until the address is confirmed
// (src/data/site.ts), a visible "[to confirm]" marker is shown instead.
import { site } from '../data/site';
import { type Lang, useT } from '../i18n/ui';
interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const { user, domain } = site.email as { user: string; domain: string };
const has = Boolean(user && domain);
const rev = (s: string) => Array.from(s).reverse().join('');
const marker = `[${t('contact.email').toLowerCase()} — to confirm]`;
---

{has ? (
  <button class="btn email" type="button" data-u={rev(user)} data-d={rev(domain)}>
    {t('contact.emailShow')} <span class="arw" aria-hidden="true">→</span>
  </button>
) : (
  <span class="tbc">{marker}</span>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('button.email[data-u]').forEach((b) => {
    b.addEventListener('click', () => {
      const r = (s: string) => Array.from(s).reverse().join('');
      const addr = `${r(b.dataset.u ?? '')}@${r(b.dataset.d ?? '')}`;
      const a = document.createElement('a');
      a.className = 'btn';
      a.href = `mailto:${addr}`;
      a.textContent = addr;
      b.replaceWith(a);
      a.focus();
    });
  });
</script>
